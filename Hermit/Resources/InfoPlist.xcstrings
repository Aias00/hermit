{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Kamera fotografierst du etwa Whiteboards, Skizzen oder Bildschirme und hängst sie an eine Terminalsitzung an. Fotos werden auf diesem Gerät von Ortsdaten befreit und nur auf deinen eigenen Server geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera lets you photograph something — a whiteboard, a sketch, a screen — and attach it to your terminal session. Photos are stripped of location data on this device and uploaded only to your own server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara sirve para fotografiar pizarras, bocetos o pantallas y adjuntarlos a una sesión de terminal. Las fotos pierden los datos de ubicación en este dispositivo y solo se suben a tu propio servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo sert à photographier un tableau blanc, un croquis ou un écran pour le joindre à une session de terminal. Les photos sont débarrassées de leurs données de localisation sur cet appareil et ne sont envoyées qu’à votre propre serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラでホワイトボードやスケッチ、画面などを撮影し、ターミナルセッションに添付できます。写真はこの端末上で位置情報を取り除き、あなた自身のサーバーにのみアップロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라로 화이트보드, 스케치, 화면 등을 찍어 터미널 세션에 첨부합니다. 사진은 이 기기에서 위치 정보를 제거한 뒤 사용자의 서버에만 업로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera serve para fotografar quadros brancos, rascunhos ou telas e anexar a uma sessão de terminal. As fotos perdem os dados de localização neste aparelho e só são enviadas ao seu próprio servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机用来拍点东西，比如白板、草图、屏幕，然后附到终端会话里。照片会在这台设备上去掉位置信息，只上传到你自己的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機用來拍點東西，比如白板、草圖、螢幕，然後附加到終端機工作階段。照片會在這部裝置上移除位置資訊，只上傳到你自己的伺服器。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperrt SSH-Schlüssel mit Face ID"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Face ID to unlock SSH keys"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea las claves SSH con Face ID"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouille les clés SSH avec Face ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID で SSH キーをロック解除します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID로 SSH 키를 잠금 해제합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueia as chaves SSH com Face ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Face ID 解锁 SSH 密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Face ID 解鎖 SSH 金鑰"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit verbindet sich per SSH und mosh (UDP) mit Servern in deinem lokalen Netzwerk. Ohne diese Berechtigung schlagen Verbindungen zu Hosts wie 192.168.x.x fehl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit connects to servers on your local network over SSH and mosh (UDP). Without this permission, connections to LAN hosts (e.g. 192.168.x.x) will fail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit se conecta por SSH y mosh (UDP) a los servidores de tu red local. Sin este permiso, las conexiones a hosts como 192.168.x.x fallan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit se connecte en SSH et mosh (UDP) aux serveurs de votre réseau local. Sans cette autorisation, les connexions à des hôtes comme 192.168.x.x échouent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit は SSH と mosh（UDP）でローカルネットワーク上のサーバーに接続します。この許可がないと、192.168.x.x のような LAN 上のホストへの接続は失敗します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit은 SSH와 mosh(UDP)로 로컬 네트워크의 서버에 연결합니다. 이 권한이 없으면 192.168.x.x 같은 내부 호스트에 연결할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hermit conecta por SSH e mosh (UDP) aos servidores da sua rede local. Sem esta permissão, conexões a hosts como 192.168.x.x falham."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit 通过 SSH 和 mosh（UDP）连接你局域网里的服务器。没有这个权限，连 192.168.x.x 这类内网主机会失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit 透過 SSH 和 mosh（UDP）連線到你區域網路裡的伺服器。沒有這個權限，連 192.168.x.x 這類內網主機會失敗。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit verwendet das Mikrofon zur Spracheingabe. Apple und Whisper erkennen Sprache auf diesem Gerät. Wenn du Doubao wählst, wird die Aufnahme beim Stoppen oder Wiederholen zur Erkennung an Volcengine gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit uses the microphone for voice input. Apple and Whisper recognize on this device. If you choose Doubao, stopping or retrying sends your recording to Volcengine for recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit usa el micrófono para la entrada de voz. Apple y Whisper reconocen en este dispositivo. Si eliges Doubao, al detener o reintentar se envía la grabación a Volcengine para reconocerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit utilise le microphone pour la saisie vocale. Apple et Whisper reconnaissent la parole sur cet appareil. Avec Doubao, arrêter ou réessayer envoie votre enregistrement à Volcengine pour la reconnaissance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit は音声入力にマイクを使用します。Apple と Whisper は端末内で認識します。Doubao を選ぶと、停止または再試行時に録音を Volcengine に送信して認識します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit은 음성 입력에 마이크를 사용합니다. Apple과 Whisper는 기기에서 인식합니다. Doubao를 선택하면 중지하거나 다시 시도할 때 녹음이 Volcengine으로 전송되어 인식됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hermit usa o microfone para entrada de voz. Apple e Whisper reconhecem neste aparelho. Ao escolher Doubao, parar ou tentar novamente envia a gravação à Volcengine para reconhecimento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit 使用麦克风录入语音。Apple 和 Whisper 在本机识别；选择豆包后，停止转写或重试会将录音发送到火山引擎识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit 使用麥克風輸入語音。Apple 和 Whisper 在本機辨識；選擇豆包後，停止轉寫或重試會將錄音傳送至火山引擎辨識。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Apple gewählt ist, verwendet Hermit die Spracherkennung auf dem Gerät. Doubao ist eine separate Cloud-Option, die Aufnahmen beim Stoppen oder Wiederholen an Volcengine sendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermit uses Apple's on-device speech recognition when Apple is selected. Doubao is a separate cloud option that sends recordings to Volcengine when you stop or retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al elegir Apple, Hermit usa el reconocimiento en el dispositivo. Doubao es una opción de nube independiente que envía grabaciones a Volcengine al detener o reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Apple, Hermit utilise la reconnaissance vocale sur l’appareil. Doubao est une option cloud distincte qui envoie les enregistrements à Volcengine lorsque vous arrêtez ou réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple を選択すると、Hermit は端末内の音声認識を使います。Doubao は別のクラウドオプションで、停止または再試行時に録音を Volcengine に送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple을 선택하면 Hermit은 기기 내 음성 인식을 사용합니다. Doubao는 중지하거나 다시 시도할 때 녹음을 Volcengine으로 보내는 별도의 클라우드 옵션입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao escolher Apple, o Hermit usa o reconhecimento no aparelho. Doubao é uma opção de nuvem separada que envia gravações à Volcengine ao parar ou tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Apple 时，Hermit 使用 Apple 的设备端语音识别。豆包是单独的云识别选项，会在停止转写或重试时将录音发送到火山引擎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Apple 時，Hermit 使用 Apple 的裝置端語音辨識。豆包是獨立的雲端辨識選項，會在停止轉寫或重試時將錄音傳送至火山引擎。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
